# Copia este archivo a .env y cambia todos los valores de ejemplo.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/asistia.sqlite
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=20m
CORS_ORIGIN=http://localhost:5173
# Bootstrap opcional: crea empresa y usuario administrador SOLO si la base está vacía.
BOOTSTRAP_COMPANY_NAME=Empresa de prueba
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Opcional: número exacto de proxies confiables delante de la API (no usar si no aplica).
# TRUST_PROXY_HOPS=1

# Respaldos cifrados (genera una clave aleatoria hexadecimal de 64 caracteres y guárdala fuera del servidor).
# BACKUP_ENCRYPTION_KEY=REEMPLAZAR_POR_64_CARACTERES_HEXADECIMALES
# BACKUP_DIR=./backups
