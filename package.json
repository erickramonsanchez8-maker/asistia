{
  "name": "asistia-desktop",
  "version": "0.6.4",
  "private": true,
  "description": "ASISTIA · Control local de asistencia para Windows",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "mx.asistia.desktop",
    "productName": "ASISTIA",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/desktop-enhancements.js",
      "ASISTIA_Control_de_Asistencia.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/src",
        "to": "backend/src"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/runtime/node.exe",
        "to": "backend/runtime/node.exe"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ASISTIA-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASISTIA",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
