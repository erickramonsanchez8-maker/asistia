# Nunca guardes este archivo con valores reales ni subas claves privadas al repositorio.
NODE_ENV=production
HOST=127.0.0.1
PORT=3400
DATABASE_PATH=./data/licensing.sqlite
# Secreto aleatorio de al menos 32 caracteres, solo para endpoints administrativos.
LICENSING_ADMIN_TOKEN=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_64_CARACTERES
# Clave RSA privada PEM del servidor remoto; usar gestor de secretos en producción.
# Se admite PEM multilínea o saltos representados como \\n.
LICENSING_PRIVATE_KEY=
# La API local de ASISTIA debe llevar la clave pública correspondiente.
# LICENSING_PUBLIC_KEY=